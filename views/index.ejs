<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1>May Node and Express be with you</h1>

    <form action="/quotes" method="POST">
        <input type="text" name="character" placeholder="character">
        <input type="text" name="quote" placeholder="quote">
        <button type="submit">Submit</button>
    </form>

    <h2>Quotes</h2>
    <ul>
        <% quotes.forEach(quote => { %>
            <li>
                <strong><%= quote.character %>:</strong> "<%= quote.quote %>"
            </li>
        <% }) %>
    </ul>
</body>
</html>