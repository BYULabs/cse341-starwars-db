{
  "name": "cse341-starwars-db",
  "version": "1.0.0",
  "description": "A full-stack Star Wars quote tracking CRUD app built with Node, Express, & MongoDB.",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "echo 'CSS already compiled locally'",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/css/styles.css --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BYULabs/cse341-starwars-db.git"
  },
  "author": "Sebastián Iturralde",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BYULabs/cse341-starwars-db/issues"
  },
  "homepage": "https://github.com/BYULabs/cse341-starwars-db#readme",
  "dependencies": {
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "mongodb": "^7.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3"
  }
}
